# Copy to .env before running docker-compose:
#   Copy-Item .env.example .env
# NEVER commit .env. It is listed in .gitignore.
#
# Comments live on their own lines only. Inline comments after a value are
# parsed inconsistently across Compose versions and can end up inside the
# variable, so this file avoids them entirely.

# --- AWS ---
AWS_REGION=ap-south-1

# Leave both blank on EC2: boto3 falls back to the instance IAM role.
# An empty value is treated the same as an unset one by botocore.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- DynamoDB ---
DYNAMODB_TABLE_ASSETS=riskforge-assets
DYNAMODB_TABLE_FINDINGS=riskforge-findings
DYNAMODB_TABLE_ASSESSMENTS=riskforge-assessments
DYNAMODB_TABLE_RECOMMENDATIONS=riskforge-recommendations

# --- S3 ---
S3_BUCKET_REPORTS=riskforge-reports-prod
S3_REPORT_URL_EXPIRY=3600

# --- Bedrock ---
# Global cross-region inference profile, not a bare foundation-model ID.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=500
BEDROCK_ENABLED=true

# --- App ---
APP_ENV=production
APP_PORT=8000
CORS_ORIGINS=*

# --- Frontend ---
# Leave blank. Nginx proxies /api on the same origin, so the bundle needs no
# absolute host and there is no cross-origin request to configure.
VITE_API_BASE_URL=
